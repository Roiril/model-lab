  "requirements": [
    {
      "id": "pixels-table",
      "text": "patterns.jsonから53mmの上下カムを作り、14mm角の3画素を0〜3mm押し引きする",
      "checks": [
        "motion.interference",
        "interface.drive",
        "motion.torque"
      ]
    },
    {
      "id": "pixels-fit",
      "text": "7段の占有と外部動作域を守り、側面でも重力に頼らず動く",
      "checks": [
        "assembly.envelope",
        "interface.retention",
        "manual:実機を上向きと横向きで動かす"
      ]
    },
    {
      "id": "pixels-assembly",
      "text": "サーボ90度で組み、印刷部品と付属ホーンだけで保持する",
      "checks": [
        "assembly.path",
        "interface.retention",
        "manual:工具なしで組立と取り外し"
      ]
    },
    {
      "id": "pixels-shield",
      "text": "8mmのスカートで画素穴の奥を隠す",
      "checks": [
        "manual:0mmと3mmで斜めから内部が見えないこと"
      ]
    }
  ],
