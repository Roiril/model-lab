{
  "interface": "resident-face-v2",
  "module": "sector_flag",
  "supported_slots": ["front", "right", "back", "left", "top"],
  "parts": ["panel", "key_l", "key_r", "support", "servo_cap", "input_gear", "sector_gear", "flag", "flag_cover", "bearing_bridge", "input_bridge", "hinge_pin", "servo", "horn", "cap_foot", "input_cup", "input_spindle"],
  "mass_limit_g": 180,
  "uses": ["sg92r"],
  "motion": {"actuator": "horn", "servo": "servo", "closed_servo_deg": 60, "open_servo_deg": 120, "assembly_servo_deg": 90, "step_deg": 0.25, "duration_s": 2},
  "requirements": [
    {"id": "flag-motion", "text": "14×28×2mmの旗をm1.5・18歯相当・軸間27mmの歯車で0〜60度起こす", "checks": ["motion.interference", "motion.torque", "interface.drive"]},
    {"id": "flag-envelope", "text": "公差片側0.25mm込みで7段の占有と外部76×76×32mmを守る", "checks": ["assembly.envelope", "manual:check_local.pyの全角度の占有結果を合成担当が確認"]},
    {"id": "flag-assembly", "text": "90度で組み閉姿勢へ戻す。工具・ねじ・接着剤なしで分解できる", "checks": ["assembly.path", "interface.retention", "manual:爪を指で解除して20回着脱"]},
    {"id": "flag-shield", "text": "旗が面一に閉じ、固定壁と重なったカラーで歯車・サーボ・ホーン・内部キー・ピンを隠す", "checks": ["manual:check_shield.pyの既定585225本と追加31851655本が0件。実物も正面と斜めから確認"]},
    {"id": "flag-print", "text": "見える面にサポートを付けずPLAとPETGで刷れる", "checks": ["print.slice", "print.grounding", "print.slender"]}
  ],
  "interfaces": [
